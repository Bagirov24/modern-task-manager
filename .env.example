# =============================================================================
# Modern Task Manager — environment variables template
# Copy to .env (development) or .env.production and fill in real values.
# NEVER commit .env or .env.production to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Modern Task Manager"

# Set to false in production — disables debug tracebacks in API responses.
DEBUG=false

# -----------------------------------------------------------------------------
# Security  *** REQUIRED ***
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Weak keys are rejected at startup.
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# JWT token lifetimes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal health endpoint bearer token (optional).
# Leave empty to keep /health endpoints public.
INTERNAL_HEALTH_TOKEN=

# -----------------------------------------------------------------------------
# Database  *** REQUIRED ***
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# The app auto-converts to postgresql+asyncpg:// internally.
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskmanager

# -----------------------------------------------------------------------------
# Redis  *** REQUIRED ***
# -----------------------------------------------------------------------------
# Main cache + rate-limit + JWT blacklist store.
REDIS_URL=redis://localhost:6379/0

# Celery task queue (separate DB index recommended).
CELERY_BROKER_URL=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# DO NOT use wildcard (*) in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Prometheus metrics endpoint protection
# Set these in .env.production; passed via docker-compose env substitution.
# -----------------------------------------------------------------------------
PROMETHEUS_METRICS_USER=prometheus
PROMETHEUS_METRICS_PASS=change-me-strong-password

# -----------------------------------------------------------------------------
# External integrations (optional)
# -----------------------------------------------------------------------------
# Supabase (if using Supabase Auth instead of local JWT)
SUPABASE_URL=
SUPABASE_KEY=

# OpenAI (AI task suggestions feature)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Email (Celery worker — optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Frontend (apps/web — passed at build time via Docker ARG)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
